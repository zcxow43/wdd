{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "mvn",
      "runtimeArgs": [
        "-f",
        "develop/backend/pom.xml",
        "spring-boot:run"
      ],
      "port": 8080,
      "env": {
        "JAVA_HOME": "/Library/Java/JavaVirtualMachines/amazon-corretto-17.jdk/Contents/Home"
      }
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "develop/frontend",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
