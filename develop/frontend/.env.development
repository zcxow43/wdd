# Base URL for API calls made directly from the browser.
# Left empty on purpose: in dev, requests to /api/* are relative to the
# Vite dev server and get forwarded to the backend by the proxy below
# (see vite.config.ts / VITE_BACKEND_PROXY_TARGET), which avoids CORS
# issues entirely. Set this only if the backend is served from a
# different origin than the frontend (e.g. in production) AND that
# backend sends the appropriate CORS headers.
VITE_API_BASE_URL=

# Target used by the Vite dev server to proxy /api/* requests to the
# backend. Only used during `npm run dev`.
VITE_BACKEND_PROXY_TARGET=http://localhost:8080
