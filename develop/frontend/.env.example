# Base URL prefixed to all API requests. Leave empty to use relative paths (recommended in dev,
# where the Vite dev server proxy in vite.config.ts forwards /api/* to VITE_BACKEND_PROXY_TARGET).
VITE_API_BASE_URL=

# Backend the dev server proxies /api/* requests to. Only used by `npm run dev`.
VITE_BACKEND_PROXY_TARGET=http://localhost:8080
