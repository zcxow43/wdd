<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="pl.piomin.services.backend.mapper.SpreadGroupMapper">

    <resultMap id="spreadGroupResultMap" type="pl.piomin.services.backend.model.SpreadGroup">
        <id property="id" column="id"/>
        <result property="brandId" column="brand_id"/>
        <result property="brandCode" column="brand_code"/>
        <result property="name" column="name"/>
        <result property="depositSpread" column="deposit_spread"/>
        <result property="withdrawSpread" column="withdraw_spread"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="enrichedColumns">
        sg.id, sg.brand_id, br.code AS brand_code, sg.name, sg.deposit_spread, sg.withdraw_spread,
        sg.created_at, sg.updated_at
    </sql>

    <sql id="enrichedJoin">
        FROM spread_group sg
        JOIN brand br ON br.id = sg.brand_id
    </sql>

    <select id="findAll" resultMap="spreadGroupResultMap">
        SELECT <include refid="enrichedColumns"/>
        <include refid="enrichedJoin"/>
        <where>
            <if test="brandId != null">AND sg.brand_id = #{brandId}</if>
        </where>
        ORDER BY sg.id
    </select>

    <select id="findById" resultMap="spreadGroupResultMap">
        SELECT <include refid="enrichedColumns"/>
        <include refid="enrichedJoin"/>
        WHERE sg.id = #{id}
    </select>

    <select id="findByBrandAndName" resultMap="spreadGroupResultMap">
        SELECT <include refid="enrichedColumns"/>
        <include refid="enrichedJoin"/>
        WHERE sg.brand_id = #{brandId} AND sg.name = #{name}
    </select>

    <insert id="insert" parameterType="pl.piomin.services.backend.model.SpreadGroup"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO spread_group (brand_id, name, deposit_spread, withdraw_spread)
        VALUES (#{brandId}, #{name}, #{depositSpread}, #{withdrawSpread})
    </insert>

    <update id="update" parameterType="pl.piomin.services.backend.model.SpreadGroup">
        UPDATE spread_group
        SET name = #{name},
            deposit_spread = #{depositSpread},
            withdraw_spread = #{withdrawSpread}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM spread_group WHERE id = #{id}
    </delete>

    <!-- Used only by tests to reset the table; not exercised by the API -->
    <select id="findAllIds" resultType="long">
        SELECT id FROM spread_group
    </select>

</mapper>
