<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wdd.backend.mapper.BrandMapper">

    <resultMap id="BrandResultMap" type="com.wdd.backend.model.Brand">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="active" column="active"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findAll" resultMap="BrandResultMap">
        SELECT id, code, name, active, created_at, updated_at
        FROM brand
        <where>
            <if test="active != null">
                active = #{active}
            </if>
        </where>
        ORDER BY id
    </select>

    <select id="findById" resultMap="BrandResultMap">
        SELECT id, code, name, active, created_at, updated_at
        FROM brand
        WHERE id = #{id}
    </select>

    <update id="update" parameterType="com.wdd.backend.model.Brand">
        UPDATE brand
        SET active = #{active},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

</mapper>
